{
  "name": "receipt-tax-packet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "assets:icons": "node scripts/generate-icons.mjs",
